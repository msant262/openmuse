# Apply these values to a protected copy of .env.example; placeholders fail preflight.
# Technical package IDs, volume names and the legacy/demo UTC default remain stable.
WORKSPACE_MODE=live
AGENT_BACKEND=model
PUBLIC_API_URL=https://srv1667308.tail107988.ts.net
ALLOWED_ORIGINS=https://REPLACE_WITH_EXISTING_PRIVATE_WEB_ORIGIN
OPENMUSE_BIND_HOST=100.113.59.40
ROUTINE_TIMEZONE=Europe/Berlin
SESSION_DEVICE_IDLE_DAYS=0
API_QUOTAS_ENABLED=true
# Set only the digest created by scripts/operator_backup_token.py.
# DEPLOYMENT_OPERATOR_TOKEN_SHA256=
TASK_WORKER_ENABLED=true
COMPUTER_ENABLED=true
COMPUTER_BACKEND=native
COMPUTER_PROFILE=open
NATIVE_EXECUTOR_ID=lenovo-okami
NATIVE_EXECUTOR_REGISTRATIONS_FILE=/run/secrets/native-executors.json
NATIVE_COMMAND_MEMORY_MB=3072
BROWSER_FALLBACK_ENABLED=true
BROWSER_EXECUTOR_ID=openmuse-server
BROWSER_REQUIRE_BINDING=true
PROACTIVITY_ENABLED=true
PROACTIVITY_INTERVAL_HOURS=4
FILE_VERSION_RETENTION_DAYS=30
FILE_VERSION_MAX_BYTES=2147483648
CAPTCHA_MAX_SUBMISSIONS=3
CAPTCHA_ATTEMPT_MS=60000
CREDENTIALS_OPENBAO_ADDR=http://openbao:8200
CREDENTIALS_OPENBAO_MOUNT=secret
# Retain the real reviewed MODEL/CAPABILITIES and file-based provider login configs.
# Supply OPENMUSE_ACCESS_KEY, TOKEN_ENCRYPTION_KEY, WORKER_TOKEN and scoped
# CREDENTIALS_OPENBAO_TOKEN privately; no node/root/backup/recovery key belongs here.
# Tailscale Serve must be enabled and verified before claiming this HTTPS URL works.
