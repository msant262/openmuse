# Copy to .env. Sample mode stays on localhost and uses fictional data.
# Threads persist in the local PGlite/Postgres database; no vendor key is needed.
WORKSPACE_MODE=sample
AGENT_BACKEND=sample
PORT=8787
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# For a static web build hosted alongside /api, use its current HTTPS origin.
# This flag affects web only; Android still needs EXPO_PUBLIC_API_URL at build time.
EXPO_PUBLIC_WEB_SAME_ORIGIN=false
# EXPO_PUBLIC_API_URL=https://app.example.com
# Pairing has no idle expiry by default; access tokens always last 15 minutes.
SESSION_DEVICE_IDLE_DAYS=0
DATA_DIR=.openmuse
TASK_WORKER_ENABLED=true
# Per-owner/device API quotas reserve Stop and screen controls separately from polls.
API_QUOTAS_ENABLED=true
# Optional root backup operator: only the SHA256 of a separate random odb1 token.
# Bootstrap with scripts/operator_backup_token.py; never put its plaintext here.
# DEPLOYMENT_OPERATOR_TOKEN_SHA256=
# Live due-review loop; it shares the same four durable task slots. Demo is unchanged.
PROACTIVITY_ENABLED=false
PROACTIVITY_INTERVAL_HOURS=4

# General delegated work: select AGENT_BACKEND=model and a provider/model.
# MODEL=openai/your-model-id
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=  # optional compatible Anthropic gateway
# GOOGLE_API_KEY=
# GEMINI_API_KEY=  # alias if GOOGLE_API_KEY is absent
# GOOGLE_GENERATIVE_AI_BASE_URL=  # optional Gemini endpoint
# Optional OpenAI-compatible Responses API endpoint:
# OPENAI_BASE_URL=
# For a gateway model ID such as vendor/model, set MODEL=openai/vendor/model.

# Subscription providers and explicitly ordered fallback (no implicit billed-key fallback).
# First run the login/import commands in docs/MODEL-BACKENDS.md.
# MODEL=chatgpt/account-model-slug
# MODEL_FALLBACKS=grok/your-account-model-id,mimo/your-plan-model-id
# CHATGPT_AUTH_FILE=.openmuse/credentials/chatgpt.json  # default under DATA_DIR
# MODEL=grok/grok-4.6
# GROK_AUTH_FILE=.openmuse/credentials/grok.json        # default under DATA_DIR

# Shared within ONE API process with its embedded task worker. No cross-process quota claim.
# MODEL_QUOTA_SCOPE=process  # shared fails closed until a shared admission adapter is configured
# MODEL_PROVIDER_QUOTAS={"chatgpt":{"total":4},"grok":{"total":4},"mimo":{"total":4}}
# Defaults: up to 3 background + 1 chat inference per provider, reduced by total quota.
# At total=1, background uses the idle seat and queued chat takes the next free seat.
# Explicit declarations for your account's selected models; never infer vision from a provider.
# contextTokens is the model's real window, not a spending/latency budget.
# Prefer account catalog metadata; declare the actual verified window when metadata is absent.
# GPT-6 Luna: https://developers.openai.com/api/docs/models/gpt-6-luna
# MODEL_CAPABILITIES={"chatgpt/gpt-6-luna":{"tools":true,"vision":true,"structuredOutput":true,"contextTokens":1050000}}
# MODEL_MAX_ATTEMPTS=3  # total HTTP attempts across candidates; SDK retries are disabled
# MODEL_DEADLINE_MS=300000  # quota wait + attempts, same deadline throughout failover
# MODEL_ATTEMPT_TIMEOUT_MS=60000  # leaves time for another configured candidate
# MODEL_COOLDOWN_MS=200  # exponential transient cooldown; Retry-After takes precedence
# MODEL_IMAGE_CONTEXT_TOKENS=8192  # per image allowance; calibrate against actual selected models

# MiMo Token Plan: copy your dedicated regional URL/key from the plan dashboard.
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_API_KEY=  # dedicated Token Plan key; never use a pay-per-token key here
# MIMO_API=responses  # responses (default) or chat-completions
# MODEL=mimo/mimo-v2.5-pro

# Any OpenAI-compatible endpoint; arbitrary model IDs, optional key for keyless servers.
# MODEL=compatible/vendor/model-id
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_API=chat-completions  # default; responses when supported

# Ollama or llama.cpp; install the model on the configured host separately.
# MODEL=local/installed-model-id  # aliases ollama/ and llamacpp/ also work
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_API_KEY=  # optional for authenticated local gateways
# LOCAL_API=chat-completions

# Image-generation capability for computer/media tools: disabled until explicit.
# Set only when this provider/endpoint actually supports POST /images/generations.
# OPENAI_IMAGE_MODEL=gpt-image-1  # explicitly billed OpenAI provider only
# GROK_IMAGE_MODEL=grok-imagine-image  # subscription eligibility depends on xAI
# OPENAI_COMPATIBLE_IMAGE_MODEL=
# LOCAL_IMAGE_MODEL=  # ordinary Ollama/llama.cpp text servers do not offer this route
# SIWC and MiMo do not enable hosted image generation.

# Original plush avatar candidates and video loops use a separate media provider.
# auto uses the existing Grok OAuth grant when present, independently of MODEL.
# off disables generation but keeps owned uploads and saved characters available.
AVATAR_PROVIDER=auto
AVATAR_IMAGE_MODEL=grok-imagine-image-2.0
AVATAR_VIDEO_MODEL=grok-imagine-video-1.5

# Live Google workspace: WORKSPACE_MODE=live, AGENT_BACKEND=model.
# OPENMUSE_ACCESS_KEY=  # random secret, at least 24 characters
# TOKEN_ENCRYPTION_KEY=  # 32 random bytes encoded as base64
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAuth callback is PUBLIC_API_URL + /api/google/callback

# Credential broker uses OpenBao on the same VPS. The OpenMuse API token must
# have only deploy/openbao/credentials-policy.hcl; never use the OpenBao root token.
# CREDENTIALS_OPENBAO_ADDR=http://openbao:8200  # private Compose network address
# CREDENTIALS_OPENBAO_TOKEN=  # scoped server-only token; never pass it to a bot/browser
# OPENMUSE_OPENBAO_VOLUME=openmuse-openbao-data
# CREDENTIALS_OPENBAO_MOUNT=secret
CAPTCHA_MAX_SUBMISSIONS=3
CAPTCHA_ATTEMPT_MS=60000
# CREDENTIAL_ADAPTERS_JSON=[]  # operator-reviewed exact HTTPS origins and fixed selectors

# Optional separate task worker; all processes share DATA_DIR for attachment files.
# DATABASE_URL=postgresql://...
# Set TASK_WORKER_ENABLED=false on the API when using pnpm dev:worker.

# Browser worker (separate from the task worker):
# BROWSER_WORKER_URL=http://127.0.0.1:8790
# WORKER_TOKEN=  # same random 32+ character secret in API and browser worker
WORKER_DATA_DIR=.openmuse/browser-profiles
WORKER_HOST=127.0.0.1
# Opt-in hybrid browser routing; the legacy worker adapter remains the default.
BROWSER_FALLBACK_ENABLED=false
BROWSER_EXECUTOR_ID=openmuse-server
BROWSER_REQUIRE_BINDING=false
# Hybrid overlay requires the native registrations file in deployment-secrets.
# NATIVE_EXECUTOR_ID=okami-bot
# NATIVE_EXECUTOR_REGISTRATIONS_FILE=/run/secrets/native-executors.json
# Hybrid-only publication: localhost behind private HTTPS, or the exact Tailscale IP.
# OPENMUSE_BIND_HOST=127.0.0.1
# See deploy/hybrid.env.example for Europe/Berlin and the existing two-host topology.
# The native node ID, credential FILE, heartbeat and technical TTL are protected
# /etc/okami-executor JSON/protocol settings, not browser/mobile/server secrets.

# An optional external raw AG-UI agent replaces conversational routing only.
# AGENT_BACKEND=agui
# AGENT_URL=https://your-agent.example/run
# AGENT_TOKEN=
# OpenBot's Intelligence runtime is not this raw AG-UI URL. See its adapter docs.

# Optional legacy CopilotKit Intelligence storage instead of local threads.
# Existing cloud thread IDs remain separate from local storage. Keep this server-only.
# npx copilotkit@latest login
# npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# Optional private Docker Linux computer (separate from the browser).
# Build first: docker build -t openmuse-computer:local apps/computer
# Docker must be reachable from the API and any separate task worker.
COMPUTER_ENABLED=false
COMPUTER_IMAGE=openmuse-computer:local
COMPUTER_BACKEND=docker
COMPUTER_PROFILE=offline
# Open RPC deployment: API never needs Docker or its socket.
# Build computer: docker build -f apps/computer/Dockerfile.open -t openmuse-computer:open apps/computer
# Build gateway: docker build -f apps/computer/Dockerfile.gateway -t openmuse-computer-gateway:local apps/computer
# COMPUTER_ENABLED=true
# COMPUTER_BACKEND=rpc
# COMPUTER_PROFILE=open
# COMPUTER_URL=http://computer-egress:8811  # private authenticated gateway; no published ports
# COMPUTER_TOKEN=  # 32+ random characters, passed ONLY to API and separate gateway PID namespace
COMPUTER_COMMAND_TIMEOUT_MS=1800000
# Stable physical-host key shared by every OpenMuse worker using resources on this machine.
# Set a different value on the other machine; the default is openmuse-server.
RESOURCE_HOST_ID=openmuse-server
# Gateway-only variables; all VPS public IPv4 aliases must be blocked too.
# COMPUTER_SERVER_IP=172.30.88.2  # API's fixed private control bridge IP
# COMPUTER_HOST_PUBLIC_IPS=  # comma-separated actual public IPv4 addresses of this VPS
# COMPUTER_MAX_BACKGROUND_JOBS=1  # supervisor supports one job at a time on this VPS
# Stable deployment name shared by API and worker; defaults to a hash of PUBLIC_API_URL.
# COMPUTER_DEPLOYMENT_ID=my-openmuse
# Optional scoped Docker engine, e.g. DOCKER_CONTEXT=colima-openmuse

# Optional Jev interaction choices: off (default), sample scripted decisions, or live SDK.
JEV_MODE=off
# live sends the latest user message, agent-written context and candidate choices to TypeSafe;
# see docs/demos/jev-generative-ui.md#what-live-mode-sends-to-typesafe
# TYPESAFE_API_KEY=  # server-only; required for JEV_MODE=live
# JEV_MODEL=jev-1.13.0

# Live Gmail/Calendar actions execute autonomously; money actions always need native review.
# Use all to review every supported native/browser/MCP action. Samples keep scripted reviews.
APPROVAL_POLICY=money

# Personal recurring tasks. Explicit IANA timezone; cron uses local wall-clock time.
ROUTINE_TIMEZONE=UTC
# Personal deployment selected Europe/Berlin; set it explicitly in that instance.
# Periodic live personal review. These are defaults until changed by the user.
# This cadence is separate from the executor's technical heartbeat.
PROACTIVITY_ENABLED=true
PROACTIVITY_INTERVAL_HOURS=4
# Fixed adapter challenge bounds. No automatic retry of an uncertain login.

# Optional remote MCP: exact URL/headers exported by your server (Composio sessions supported).
# Configure ONE source. Keep session URLs and secret header values out of version control.
# MCP_CONFIG_FILE=/run/secrets/openmuse-mcp.json  # schema: docs/ROUTINES-CONNECTORS-MEMORY.md
# OAuth servers also require the operator callback/client setup in docs/MCP-OAUTH.md.
# MCP_SERVERS_JSON=[]
# COMPOSIO_API_KEY=  # only used when referenced by the configured returned header
# COMPOSIO_USER_API_KEY=
# COMPOSIO_ORG_ID=
# COMPOSIO_PROJECT_ID=
# Add env refs for every other returned credential/account header as needed.

# Optional direct native APNs (iOS); no Expo push service.
# APNS_KEY_FILE=/run/secrets/AuthKey.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=  # signed app's actual bundle identifier
APNS_SANDBOX=false

# Optional direct FCM HTTP v1 (Android), independent of Workspace OAuth.
# FCM_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json
# FCM_PROJECT_ID=
# GOOGLE_SERVICES_FILE=/absolute/path/google-services.json  # mobile native BUILD only
# Rebuild native app with expo-notifications; enable Phone notifications in Apps.

# Root docker-compose.yml VPS settings; overrides local mode/backend/data paths.
# See DEPLOY.md. The API is published only on 127.0.0.1:8787; use private HTTPS/HTTPS proxy.
# Set actual PUBLIC_API_URL, MODEL, access/encryption/worker/computer keys and public IPs.
# COMPUTER_CONTROL_SUBNET=172.30.88.0/24  # choose a subnet not overlapping existing routes
# COMPUTER_DYNAMIC_RANGE=172.30.88.128/25  # inside that subnet, excluding fixed server IP
# COMPUTER_SERVER_IP=172.30.88.2        # must belong to that subnet, fixed API ingress IP
# COMPUTER_HOST_PUBLIC_IPS=            # mandatory ALL actual VPS public IPv4/NAT aliases
# OPENMUSE_SERVER_VOLUME=openmuse-server-data
# OPENMUSE_BROWSER_VOLUME=openmuse-browser-data
# OPENMUSE_WORKSPACE_VOLUME=openmuse-workspace
# OPENMUSE_HOME_VOLUME=openmuse-computer-home
# OPENMUSE_OPENBAO_VOLUME=openmuse-openbao-data
# Compose fixes DATA_DIR/credential paths inside server-data and one background computer job.
# Backup options are host CLI arguments, not secrets passed into containers:
# scripts/backup.sh --project-dir /opt/openmuse --env-file /opt/openmuse/.env
#   --backup-dir /var/backups/openmuse --retention-days 14 --timeout-seconds 1800
# Custom MCP headerEnv names require an explicit API-only Compose override (DEPLOY.md).

# Native command/media admission budget (host reserve and measured capacity still apply).
NATIVE_COMMAND_MEMORY_MB=3072
# File versions and trash share an account budget; restoring validates current version.
FILE_VERSION_RETENTION_DAYS=30
FILE_VERSION_MAX_BYTES=2147483648
# Encrypted backup recipient, root-only API/SSH token FILES, target and retention
# are host configs in deploy/backup/*.example.json, never application env variables.
