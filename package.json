{
  "name": "openmuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "dev": "pnpm build:harness && tsx watch apps/server/src/index.ts",
    "auth": "tsx apps/server/src/providers/auth-cli.ts",
    "dev:demo": "tsx apps/server/src/demo/entry.ts",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "dev:web": "pnpm --dir apps/mobile web",
    "test": "pnpm build:harness && tsx --test tests/*.test.ts apps/mobile/test/*.test.ts",
    "test:browser": "node --experimental-strip-types --test apps/worker/tests/lifecycle.test.ts apps/worker/tests/agent-page.test.ts apps/worker/tests/payments.test.ts",
    "typecheck": "tsc --noEmit && pnpm --dir apps/mobile typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-server-assets.mjs && node scripts/build-openclaw-harness.mjs",
    "start": "node dist/apps/server/src/index.js",
    "build:web": "pnpm --dir apps/mobile build:web",
    "build:ios": "pnpm --dir apps/mobile build:ios",
    "build:android": "pnpm --dir apps/mobile build:android",
    "dev:worker": "pnpm build:harness && tsx apps/server/src/worker-entry.ts",
    "start:worker": "node dist/apps/server/src/worker-entry.js",
    "dev:browser": "node --env-file=.env --experimental-strip-types apps/worker/src/index.ts",
    "test:computer": "tsx --test apps/computer/smoke.test.ts",
    "build:harness": "node scripts/build-openclaw-harness.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@anthropic-ai/sdk": "0.128.0",
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@copilotkit/runtime": "1.70.1",
    "@earendil-works/pi-tui": "0.86.1",
    "@electric-sql/pglite": "^0.3.14",
    "@google/genai": "2.24.0",
    "@hono/node-server": "^1.19.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@mistralai/mistralai": "2.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.0.10",
    "@openclaw/fs-safe": "0.23.0",
    "@openclaw/proxyline": "0.3.12",
    "@pdf-lib/fontkit": "1.1.1",
    "@silvia-odwyer/photon-node": "0.3.4",
