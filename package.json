    "kysely": "0.29.6",
    "libphonenumber-js": "1.13.13",
    "linkedom": "0.18.13",
    "markdown-it": "15.0.2",
    "markdown-it-cjk-friendly": "3.0.0",
    "marked": "18.0.14",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.2",
    "minimatch": "10.2.6",
    "openai": "7.23.0",
    "p-limit": "7.3.3",
