    "tar": "7.5.22",
    "tslog": "5.2.0",
    "typebox": "1.3.34",
    "undici": "8.11.2",
    "web-push": "3.6.7",
    "web-tree-sitter": "0.27.0",
    "ws": "8.21.3",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@copilotkit/aimock": "1.42.0",
    "@copilotkit/core": "1.70.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
