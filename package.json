    "@tanstack/ai-gemini": "^0.32.1",
    "@tanstack/ai-openai": "^0.23.2",
    "@typesafe-ai/sdk": "0.6.0",
    "@xmldom/xmldom": "0.9.12",
    "acorn": "8.18.0",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "cron-parser": "5.6.0",
    "croner": "10.0.1",
    "diff": "9.0.0",
    "docx": "9.8.1",
    "dotenv": "18.0.3",
    "entities": "8.1.0",
    "execa": "10.0.1",
    "file-type": "22.1.1",
    "google-auth-library": "10.9.1",
    "hono": "^4.11.4",
    "hosted-git-info": "10.1.1",
    "iconv-lite": "0.7.3",
    "ignore": "7.0.9",
    "import-meta-resolve": "4.2.0",
